# Единый вход ядра: три адреса на 80/443 (TLS выпускает Caddy сам).
# Порты Supabase (8000) и Jitsi web (8002) наружу НЕ открыты — только через Caddy.

# Сайт
{$APP_DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	@stage host stage.*
	header @stage X-Robots-Tag "noindex, nofollow"
	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 15s
		health_timeout 5s
	}
}

# Supabase (self-hosted): шлюз на docker-мосте
{$DB_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	reverse_proxy host.docker.internal:8000 {
		flush_interval -1
	}
}

# Jitsi web (HTTP на 8002 внутри хоста; медиа JVB идёт напрямую по UDP 10000, мимо Caddy)
{$MEET_DOMAIN} {
	reverse_proxy host.docker.internal:8002 {
		flush_interval -1
	}
}
