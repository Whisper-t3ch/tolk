# Шаблон ~/core/.env.core (chmod 600). Значения в чат и репозиторий не отправлять.
APP_DOMAIN=stage.tolkplace.ru
DB_DOMAIN=db.tolkplace.ru
MEET_DOMAIN=meet.tolkplace.ru
NEXT_PUBLIC_APP_URL=https://stage.tolkplace.ru
NEXT_PUBLIC_JITSI_DOMAIN=meet.tolkplace.ru
# Заполняется командой: cd ~/supabase && ./sb.sh sync-frontend ~/core/.env.core
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Серверные секреты (core.sh init генерирует CRON_SECRET и RECORDING_WEBHOOK_SECRET)
CRON_SECRET=
RECORDING_WEBHOOK_SECRET=
# ASR на отдельной ВМ. Токен копируется с ASR-ВМ без вывода (см. README).
RECORDING_ASR_ADAPTER=http
ASR_SERVICE_URL=http://37.139.33.64:8000
ASR_SERVICE_TOKEN=
# ИИ: для тестов НЕ вписывать ключ боевого аккаунта Яндекса (используйте тестовый или оставьте пустым: функции ИИ вернут ошибку)
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_LITE_MODEL=
YANDEX_GPT_PRO_MODEL=
YANDEX_EMBEDDINGS_MODEL=
YANDEX_EMBEDDINGS_MODEL_QUERY=
YANDEX_SEARCH_API_KEY=
JITSI_JWT_APP_ID=
JITSI_JWT_APP_SECRET=
# Боевой режим (tolkplace.ru) включается ./switch_domain.sh prod: CADDYFILE=./Caddyfile.prod, STAGE_DOMAIN=stage.tolkplace.ru
CADDYFILE=
STAGE_DOMAIN=

# Обезличивание: 1 = первые имена третьих лиц остаются, убираются фамилии и отчества. Включать только после обновления согласия клиента и политики.
# ANON_KEEP_FIRST_NAMES=1
