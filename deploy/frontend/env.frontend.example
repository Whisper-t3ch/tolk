# Шаблон ~/asr-service/.env.frontend. Заполняет ВЛАДЕЛЕЦ на ВМ (chmod 600). Значения в чат/репозиторий не отправлять.
# --- домены и публичные значения (вшиваются в сборку) ---
FRONTEND_DOMAINS=stage.tolkplace.ru
# Домен self-hosted Supabase (см. deploy/supabase). Пусто = не публиковать.
DB_DOMAINS=
NEXT_PUBLIC_APP_URL=https://stage.tolkplace.ru
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_JITSI_DOMAIN=meet.tolkplace.ru
# --- серверные секреты (только рантайм) — те же имена, что в Vercel ---
SUPABASE_SERVICE_ROLE_KEY=
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_LITE_MODEL=
YANDEX_GPT_PRO_MODEL=
YANDEX_EMBEDDINGS_MODEL=
YANDEX_EMBEDDINGS_MODEL_QUERY=
YANDEX_SEARCH_API_KEY=
RECORDING_WEBHOOK_SECRET=
CRON_SECRET=
RECORDING_ASR_ADAPTER=http
# Внутри docker-сети ASR доступен без TLS и внешнего Caddy:
ASR_SERVICE_URL=http://asr:8000
ASR_SERVICE_TOKEN=
# JITSI_JWT_APP_ID / JITSI_JWT_APP_SECRET: перенесите ровно то, что сейчас в Vercel (для паритета).
# JWT-enforcement на стороне Jitsi НЕ включаем без отдельной команды.
JITSI_JWT_APP_ID=
JITSI_JWT_APP_SECRET=
